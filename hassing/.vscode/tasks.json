{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run CP",
            "type": "shell",
            "command": ".\\run.bat",
            "args": [
                "${fileBasename}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "focus": false
            }
        }
    ]
}